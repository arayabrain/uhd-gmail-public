# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Jupyter
notebooks/local/
.ipynb_checkpoints
tests.ipynb
sandbox.ipynb
cosine_similarity.ipynb
gwilliams2022.ipynb

# VS Code
/.vscode/**/*
!/.vscode/settings.json
outputs/

# Data
data/*
!data/.gitkeep
!data/subject_demographics.example.csv
!data/intersubject/
!data/intersubject/**
!data/voice_volume/
!data/voice_volume/**

# Local path config (keep only the example tracked)
configs/paths.yaml

# Agent / editor local state
.claude/

# Run outputs and temp files
outputs/
tmp/
runs/
wandb/

# Micellaneous
*.pt
train.sh
*_debug*
nohup.out
.python-version
*.egg-info
*.log
logs/*
# Ignore root-level figure dumps; keep tracked figure scripts
/figures/
!scripts/figures/
!scripts/figures/**
# Negation above re-includes bytecode; keep __pycache__ ignored.
scripts/figures/**/__pycache__/
__pycache__/
*.code-workspace
